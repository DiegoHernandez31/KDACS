[gd_scene format=3 uid="uid://bfb5dmkao1xht"]

[sub_resource type="GDScript" id="GDScript_4417n"]
script/source = "
extends StaticBody3D

signal broken

const MODEL_PATH := \"res://resources/models/caja_madera.glb\"

@export var model_scene: PackedScene
@export var max_health: float = 10.0
@export var crate_size: Vector3 = Vector3(0.8, 0.8, 0.8)

@export_group(\"Drops\")
@export var guaranteed_drop: PackedScene = preload(\"res://doll_pick_up.tscn\")   # suelta SIEMPRE esto
@export var drops: Array[PackedScene] = []            # extras opcionales
@export_range(0.0, 1.0) var drop_chance: float = 1.0  # probabilidad de los extras

@export_group(\"Mapa\")
@export var is_unique: bool = true                    # solo puede existir una en el mapa

@export_group(\"Efectos\")
@export var debris_count: int = 10

@export_group(\"Compatibilidad\")
@export var hit_as_enemy: bool = false                # actívalo si tus ataques solo golpean al grupo \"enemies\"

var current_health: float
var is_broken := false
var _model: Node3D


func _ready() -> void:
	add_to_group(\"breakable\")
	if is_unique:
		add_to_group(\"unique_crate\")
	if hit_as_enemy:
		add_to_group(\"enemies\")
	current_health = max_health

	var col := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = crate_size
	col.shape = box
	col.position.y = crate_size.y / 2.0
	add_child(col)

	if model_scene == null and ResourceLoader.exists(MODEL_PATH):
		model_scene = load(MODEL_PATH)
	if model_scene:
		_model = model_scene.instantiate() as Node3D
		add_child(_model)


func take_damage(amount: float) -> void:
	if is_broken:
		return
	current_health -= amount
	_hit_shake()
	if current_health <= 0.0:
		_break()


func _hit_shake() -> void:
	if _model == null:
		return
	var off := Vector3(randf_range(-1, 1), 0, randf_range(-1, 1)).normalized() * 0.05
	var t := create_tween()
	t.tween_property(_model, \"position\", off, 0.04)
	t.tween_property(_model, \"position\", Vector3.ZERO, 0.08)


func _break() -> void:
	is_broken = true
	broken.emit()
	_spawn_debris()
	_spawn_drops()
	queue_free()


func _spawn_drops() -> void:
	if guaranteed_drop != null:
		_spawn_item(guaranteed_drop)
	if not drops.is_empty() and randf() <= drop_chance:
		_spawn_item(drops.pick_random())


func _spawn_item(scene: PackedScene) -> void:
	if scene == null:
		return
	var item := scene.instantiate()
	get_tree().current_scene.add_child(item)
	if item is Node3D:
		(item as Node3D).global_position = global_position + Vector3(0, 0.3, 0)
	if item is RigidBody3D:
		(item as RigidBody3D).linear_velocity = Vector3(randf_range(-1, 1), 3.0, randf_range(-1, 1))


func _spawn_debris() -> void:
	var parent := get_tree().current_scene
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(0.45, 0.28, 0.12)
	mat.roughness = 0.9

	for i in debris_count:
		var size := Vector3(randf_range(0.06, 0.16), randf_range(0.03, 0.05), randf_range(0.2, 0.4))

		var piece := RigidBody3D.new()
		piece.collision_layer = 0
		piece.collision_mask = 1

		var col := CollisionShape3D.new()
		var shape := BoxShape3D.new()
		shape.size = size
		col.shape = shape
		piece.add_child(col)

		var mesh := MeshInstance3D.new()
		var bm := BoxMesh.new()
		bm.size = size
		bm.material = mat
		mesh.mesh = bm
		piece.add_child(mesh)

		parent.add_child(piece)
		piece.global_position = global_position + Vector3(randf_range(-0.3, 0.3), randf_range(0.2, 0.7), randf_range(-0.3, 0.3))
		piece.rotation = Vector3(randf() * TAU, randf() * TAU, randf() * TAU)
		piece.linear_velocity = Vector3(randf_range(-2, 2), randf_range(2, 4), randf_range(-2, 2))
		piece.angular_velocity = Vector3(randf_range(-8, 8), randf_range(-8, 8), randf_range(-8, 8))

		var t := piece.create_tween()
		t.tween_interval(1.5)
		t.tween_property(mesh, \"scale\", Vector3.ZERO, 0.4)
		t.tween_callback(piece.queue_free)
"

[node name="Crate" type="StaticBody3D" unique_id=1235893484]
script = SubResource("GDScript_4417n")
